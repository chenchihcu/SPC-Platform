# Project-local rules for trusted SPC Platform work.
# Keep broad Python execution, migrations, destructive changes, and release writes out of allow rules.

prefix_rule(
    pattern = [["pwsh", "powershell", "C:\\Program Files\\PowerShell\\7\\pwsh.exe", "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"], "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/harness_check.ps1"],
    decision = "allow",
    justification = "SPC Platform harness structure check is read-only and project-scoped.",
    match = [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/harness_check.ps1",
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/harness_check.ps1",
    ],
    not_match = [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    ],
)

prefix_rule(
    pattern = [["pwsh", "powershell", "C:\\Program Files\\PowerShell\\7\\pwsh.exe", "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"], "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/verify.ps1"],
    decision = "allow",
    justification = "SPC Platform full verification is non-destructive and project-scoped.",
    match = [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    ],
    not_match = [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/harness_check.ps1",
    ],
)

prefix_rule(
    pattern = [
        ["python", "py", ".venv/Scripts/python.exe", ".venv\\Scripts\\python.exe"],
        ["scripts/validate_db_chart_semantics.py", "scripts\\validate_db_chart_semantics.py"],
    ],
    decision = "allow",
    justification = "SPC Platform DB-backed chart semantic validation enforces SQLite query-only mode and rejects output paths outside Outputs.",
    match = [
        ".venv/Scripts/python.exe scripts/validate_db_chart_semantics.py --db data/spc_master.db --latest-session --output Outputs/db_chart_semantics_current --quiet",
        "python scripts/validate_db_chart_semantics.py --db data/spc_master.db --latest-session --output Outputs/db_chart_semantics_current --quiet",
    ],
    not_match = [
        "python scripts/backfill_workorder_dual_fields.py",
        "python scripts/run_release_gate.py",
    ],
)
